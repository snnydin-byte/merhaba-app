      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm ls*)",
      "Bash(npm --version)",
      "Bash(adb*)",
      "Bash(C:/Users/Sinan/AppData/Local/Android/Sdk/platform-tools/adb.exe*)",
      "Bash(MSYS_NO_PATHCONV=1 *adb.exe*)",
      "Bash(curl*)",
      "Bash(cd *)",
      "Bash(where *)",
      "Bash(env)",
      "Bash(jobs*)",
